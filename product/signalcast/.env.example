# Copy to .env and fill in. Never commit .env — it holds live secrets.
#
# The NICHE_* block is generated: run `npm run seed -- <slug>` and merge
# .env.generated in rather than writing those by hand.

# --- n8n host -----------------------------------------------------------------
N8N_HOST=n8n.yourdomain.com
N8N_USER=admin
N8N_PASSWORD=
# openssl rand -hex 32  — back this up off-host; losing it bricks saved creds.
N8N_ENCRYPTION_KEY=

# --- Supabase -----------------------------------------------------------------
# Project settings -> API. Use the SERVICE ROLE key: it bypasses RLS, which the
# schema relies on. It must never appear in the landing page or any client code.
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# --- Anthropic ----------------------------------------------------------------
# console.anthropic.com -> API keys. Set a monthly spend limit while testing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Resend (email) -----------------------------------------------------------
# resend.com -> API keys. Free tier: 3,000 emails/month, 100/day.
# You must verify a sending domain and add its SPF + DKIM records before any
# mail reaches an inbox rather than spam.
RESEND_API_KEY=

# --- Stripe -------------------------------------------------------------------
# The signing secret from the webhook endpoint you create (starts whsec_).
# Not your API key — a different value, from a different page.
STRIPE_WEBHOOK_SECRET=

# --- Public URLs and sender identity ------------------------------------------
# Base URL of the landing page. Unsubscribe links are built from it, so it must
# be the real public origin, no trailing slash.
PUBLIC_BASE_URL=https://yourdomain.com
SENDER_FROM=Your Name <briefing@yourdomain.com>
SENDER_REPLY_TO=you@yourdomain.com
# A physical postal address in the footer is legally required for commercial
# email in the US (CAN-SPAM) and expected elsewhere. A registered agent or PO
# box is fine; leaving it blank is not.
SENDER_POSTAL_ADDRESS=

# --- Niche config (generated — see above) --------------------------------------
NICHE_SLUG=ai-governance
NICHE_NAME=
NICHE_TZ=Asia/Dubai
NICHE_AUDIENCE=
NICHE_INCLUDE=
NICHE_EXCLUDE=
NICHE_SUBJECT=
NICHE_INTRO=

# --- Tuning -------------------------------------------------------------------
# Items in the email. Fewer is usually better — this is a curation product.
MAX_ITEMS=10
# Score floor. Raise it if issues feel padded; lower it if they feel thin.
MIN_SCORE=55
# Hard cap on items sent to the model per run. Bounds the worst-case bill.
MAX_ITEMS_SCORED=60
# Ignore feed entries older than this. Stops a newly added source from dumping
# its whole back catalogue into the next issue.
LOOKBACK_DAYS=14
